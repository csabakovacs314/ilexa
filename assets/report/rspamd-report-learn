#!/usr/bin/python3
# ─────────────────────────────────────────────────────────────────
#  rspamd-report-learn — learn a user-reported message into rspamd Bayes.
#
#  Pipe target for the report addresses (Postfix local(8) via /etc/aliases,
#  runs as 'nobody'):
#     rspamlearn-spam: "|/usr/local/sbin/rspamd-report-learn spam"
#     rspamlearn-ham:  "|/usr/local/sbin/rspamd-report-learn ham"
#
#  The Thunderbird "Report Spam" (RENATER) add-on forwards the ORIGINAL
#  message as a message/rfc822 attachment. We extract that original, strip
#  scanner-added headers, and feed it to `rspamc learn_<class>` on localhost
#  (controller trusts 127.0.0.1 → no password).
#
#  Hardening: the envelope sender must be a REAL ACTIVE MAILBOX on a local
#  domain (not merely any address at a local domain -- see the sender check
#  below for why that mattered), size caps, global rate limit, must carry a
#  message/rfc822 attachment. Always exits 0 (never bounce/defer a report).
#  Every outcome is logged to syslog (mail facility → /var/log/maillog).
# ─────────────────────────────────────────────────────────────────
import sys, os, re, time, subprocess, syslog
from email.parser import BytesParser
from email.policy import compat32

CLASS        = sys.argv[1] if len(sys.argv) > 1 else ''
# Sender comes from the Postfix pipe argv (${sender}); env SENDER is a fallback
# (the pipe(8) transport, unlike local(8), does not export it reliably).
SENDER       = (sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else (os.environ.get('SENDER') or ''))
SENDER       = SENDER.lower().strip().strip('<>')
STATE_DIR    = '/var/lib/rspamd-report'
DOMAINS_FILE = '/etc/rspamd-report/domains.txt'
SENDERS_FILE = '/etc/rspamd-report/senders.txt'
MAX_TOTAL    = 8 * 1024 * 1024      # whole report cap
MAX_ORIG     = 4 * 1024 * 1024      # extracted original cap
RATE_MAX     = 120                  # max learns per window
RATE_WIN     = 60                   # seconds

# ── preserving what we refuse ────────────────────────────────────────────────
#
# This handler runs as a Postfix pipe and exits 0 on every path, which tells
# Postfix "delivered". For a report we then refuse, that means the user's
# message is GONE: no bounce, no delivery, no trace beyond a syslog line. The
# operator asked for exactly one thing here -- do not lose mail -- so a refused
# report is written to a spool file instead of evaporating.
#
# NOT EVERY REFUSAL IS PRESERVED, and the exclusion is deliberate. A report
# from a FOREIGN domain is refused before anything else and is, in practice,
# forgery or spam arriving from the open internet at an unauthenticated
# endpoint. Spooling those would hand anyone a way to fill this disk by mailing
# ham@ in a loop -- trading a mail-loss problem for an outage. Those stay
# discarded, as they always have been.
#
# What IS preserved is the case where a plausible human's message would vanish:
# a sender at one of our own domains, or a failure that is our fault (a broken
# allow-list refusing everybody), or a real verified reporter who simply
# forwarded inline instead of as an attachment -- historically the single most
# common way a report was lost here.
#
# The spool is bounded in both files and bytes, oldest pruned first, so it
# cannot grow without limit even from local senders.
PRESERVE_DIR   = '/var/spool/rspamd-report-denied'
PRESERVE_FILES = 200
PRESERVE_BYTES = 50 * 1024 * 1024

def _preserve(reason):
    """Write the refused message to the spool. Best effort, never fatal."""
    try:
        blob = globals().get('data')
        if not blob:
            return ''
        os.makedirs(PRESERVE_DIR, mode=0o700, exist_ok=True)
        os.chmod(PRESERVE_DIR, 0o700)
        # Prune BEFORE writing, so the cap is honoured even by this message.
        try:
            files = sorted(
                (os.path.join(PRESERVE_DIR, n) for n in os.listdir(PRESERVE_DIR)),
                key=lambda p: os.stat(p).st_mtime)
            total = sum(os.stat(p).st_size for p in files)
            while files and (len(files) >= PRESERVE_FILES
                             or total + len(blob) > PRESERVE_BYTES):
                victim = files.pop(0)
                total -= os.stat(victim).st_size
                os.unlink(victim)
        except OSError:
            pass
        safe = re.sub(r'[^A-Za-z0-9@._-]', '_', SENDER)[:64] or 'unknown'
        path = os.path.join(
            PRESERVE_DIR,
            f'{time.strftime("%Y%m%dT%H%M%S")}-{os.getpid()}-{CLASS}-{safe}.eml')
        # 0600: a refused report is still somebody's mail.
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as fh:
            fh.write(b'X-Ilexa-Report-Refused: ' + reason.encode('utf-8', 'replace') + b'\n')
            fh.write(b'X-Ilexa-Report-Sender: ' + SENDER.encode('utf-8', 'replace') + b'\n')
            fh.write(blob)
        return f' preserved={os.path.basename(path)}'
    except Exception:
        return ''

syslog.openlog('rspamd-report', syslog.LOG_PID, syslog.LOG_MAIL)
def done(msg, learned=False, preserve=False):
    kept = _preserve(msg) if (preserve and not learned) else ''
    syslog.syslog(syslog.LOG_INFO,
                  f'class={CLASS} sender=<{SENDER}> {"LEARN" if learned else "skip"}: {msg}{kept}')
    sys.exit(0)                     # never bounce/defer

if CLASS not in ('spam', 'ham'):
    done('bad class argument')

data = sys.stdin.buffer.read(MAX_TOTAL + 1)
if len(data) > MAX_TOTAL:
    done('report too large')

# ── sender check ──
#
# TWO GATES, AND THE SECOND ONE IS THE IMPORTANT ONE.
#
# SENDER is Postfix's ${sender}: the ENVELOPE sender, which an unauthenticated
# party asserts and nothing here has verified. This used to check only that its
# DOMAIN was local, so "nobody@hernad.hu" — an address that does not exist —
# was accepted and learned. That is a Bayes-poisoning path straight into the
# filter every user depends on: mail ham@ with spam content from a forged local
# sender and the classifier is trained to ACCEPT spam.
#
# Nothing upstream closes it on the reference host. reject_authenticated_-
# sender_login_mismatch binds authenticated senders only; policyd-spf runs
# TestOnly=1 (annotate, never reject) and the mail domains publish ~all, which
# Mail_From_reject=Fail does not act on. So the check has to be here.
#
# Gate 1 (domains.txt): which domains may report at all — the policy knob.
# Gate 2 (senders.txt): the address must be a REAL, ACTIVE MAILBOX.
#
# Both fail CLOSED. An unreadable or empty list denies every report rather than
# falling back to the weaker check: this project has been bitten before by a
# helper reading a broken state as a clean one (the rbl.conf Abusix incident),
# and a report that is silently dropped costs one training sample, where a
# forged one costs the filter's accuracy for everybody.
def _load(path):
    try:
        with open(path) as fh:
            return {l.strip().lower() for l in fh if l.strip() and not l.startswith('#')}
    except OSError:
        return set()

ours = _load(DOMAINS_FILE)
if not ours:
    done(f'no reportable domains configured ({DOMAINS_FILE} missing or empty) - denying',
         preserve=True)
dom = SENDER.rsplit('@', 1)[-1] if '@' in SENDER else ''
if not dom or dom not in ours:
    done('sender not an internal domain')

senders = _load(SENDERS_FILE)
if not senders:
    # Deliberately distinct from "not a mailbox": this one is our fault, not
    # the reporter's, and it means EVERY report is being dropped until the
    # refresher runs. It needs to look different in the log.
    done(f'sender allow-list unavailable ({SENDERS_FILE} missing or empty) - denying all reports',
         preserve=True)
if SENDER not in senders:
    # Aliases land here too, by design -- see rspamd-report-senders' header.
    done('sender is not an active mailbox on this server', preserve=True)

# ── global rate limit (simple per-window counter) ──
try:
    os.makedirs(STATE_DIR, exist_ok=True)
    win = int(time.time()) // RATE_WIN
    rf  = os.path.join(STATE_DIR, 'rate')
    cnt = 0
    try:
        p0, c0 = open(rf).read().split()
        if int(p0) == win:
            cnt = int(c0)
    except (OSError, ValueError):
        pass
    if cnt >= RATE_MAX:
        # Already past both sender gates, so this is a verified reporter whose
        # message would otherwise vanish because somebody else was noisy.
        done('rate limit exceeded', preserve=True)
    with open(rf, 'w') as f:
        f.write(f'{win} {cnt + 1}')
except OSError:
    pass                            # never fail closed on state errors

# ── extract the original (message/rfc822 attachment) ──
msg  = BytesParser(policy=compat32).parsebytes(data)
orig = None
for part in msg.walk():
    if part.get_content_type() == 'message/rfc822':
        pl = part.get_payload()
        orig = pl[0].as_bytes() if isinstance(pl, list) and pl else part.get_payload(decode=True)
        break
if not orig:
    # The commonest way a report was lost: a verified reporter who forwarded
    # the spam INLINE instead of as an attachment. Their message was correct
    # in every other respect and simply disappeared -- 5 of the 16 reports
    # this endpoint had ever received went this way.
    done('no message/rfc822 attachment', preserve=True)
if len(orig) > MAX_ORIG:
    done('original too large')

# ── strip scanner-added headers so Bayes isn't taught our own tokens ──
def strip_headers(raw: bytes) -> bytes:
    text = raw.decode('utf-8', 'surrogateescape')
    parts = re.split(r'\r?\n\r?\n', text, maxsplit=1)
    head, body = parts[0], (parts[1] if len(parts) > 1 else '')
    out, skip = [], False
    for line in head.split('\n'):
        if line[:1] in (' ', '\t'):
            if skip:
                continue
        else:
            skip = bool(re.match(r'^(x-spam|x-spamd-result|x-rspamd|x-[a-z0-9-]*mailscanner)', line, re.I))
            if skip:
                continue
        out.append(line)
    return ('\n'.join(out) + '\n\n' + body).encode('utf-8', 'surrogateescape')

orig_raw   = orig                    # as-received original (for saving to Spam)
learn_body = strip_headers(orig_raw) # scanner headers removed (for Bayes)

# ── save a copy into the reporter's Spam folder (SPAM class only) so that
#    POP3-reported spam is visible in the Karantén admin tool. Runs as the
#    dedicated 'rspamreport' user; the sudoers rule allows only `doveadm save
#    -u <user> -m Spam` (append-only, Spam mailbox). Best-effort: a save
#    failure is logged but never blocks learning. Ham is never saved to Spam.
saved = 'n/a'
if CLASS == 'spam':
    try:
        marker = f'X-Reported-Via: pop3-forward; by {SENDER}\n'.encode('utf-8', 'surrogateescape')
        sp = subprocess.run(['/usr/bin/sudo', '/usr/bin/doveadm', 'save',
                             '-u', SENDER, '-m', 'Spam'],
                            input=marker + orig_raw, capture_output=True, timeout=30)
        saved = 'ok' if sp.returncode == 0 else f'fail({sp.returncode})'
        if sp.returncode != 0:
            syslog.syslog(syslog.LOG_WARNING, f'class=spam sender=<{SENDER}> save-failed: '
                + (sp.stdout + sp.stderr).decode('utf-8', 'replace').replace('\n', ' ')[:200])
    except Exception as e:
        saved = 'error'
        syslog.syslog(syslog.LOG_WARNING, f'class=spam sender=<{SENDER}> save-error: {e}')

# ── local fuzzy storage ──
# Spam report → fuzzy_add (flag 11 = FUZZY_LOCAL_DENIED) so near-duplicate spam is caught
# server-wide. Ham report → fuzzy_del (undo a mistaken add — self-correcting). Best-effort;
# never blocks Bayes learning. Uses the header-stripped body for a stable hash.
fuzzy = 'n/a'
try:
    fz_cmd = 'fuzzy_add' if CLASS == 'spam' else 'fuzzy_del'
    fp = subprocess.run(['/usr/bin/rspamc', '-h', '127.0.0.1:11334', '-f', '11', '-w', '1', fz_cmd],
                        input=learn_body, capture_output=True, timeout=30)
    fuzzy = f'{fz_cmd}:{"ok" if fp.returncode == 0 else "rc" + str(fp.returncode)}'
except Exception as e:
    fuzzy = f'err:{e}'

# ── learn ──
try:
    p = subprocess.run(['/usr/bin/rspamc', '-h', '127.0.0.1:11334', f'learn_{CLASS}'],
                       input=learn_body, capture_output=True, timeout=30)
    out = (p.stdout + p.stderr).decode('utf-8', 'replace').replace('\n', ' ').strip()
    done(f'bytes={len(learn_body)} saved={saved} fuzzy={fuzzy} rc={p.returncode} rspamc="{out[:200]}"',
         learned=(p.returncode == 0))
except Exception as e:
    # The report was valid and the sender verified; learning failed on OUR
    # side. Losing it here would be the worst case of all -- a correct report,
    # correctly submitted, silently binned because of our fault.
    done(f'rspamc error: {e}', preserve=True)
