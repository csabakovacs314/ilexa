[Unit]
Description=Hungarian spam-classifier service (ilexa)
After=network.target

[Service]
Type=simple
ExecStart=/opt/hu-classify/venv/bin/python3 /usr/local/sbin/hu-classify-stub.py
# DynamicUser rather than a hardcoded User=nobody Group=nobody: the "nobody"
# GROUP only exists on EL, Debian/Ubuntu's equivalent is "nogroup" -- a
# hardcoded Group=nobody would fail to start on every apt-based host. This
# also gives the process no persistent identity to escalate from.
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 2026-08-18: raised from the Phase 0 stub's 64M. Measured standalone
# (load lid.176.ftz + run inference, no HTTP server): peak_rss=37.4MB.
# Budgeted with real headroom above that for the HTTP server/thread
# overhead and future growth (naturalness/spam n-gram tables land here
# next) rather than re-deriving from a single measurement.
MemoryMax=200M
MemoryHigh=160M
OOMPolicy=stop
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
