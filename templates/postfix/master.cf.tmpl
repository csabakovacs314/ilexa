#
# Postfix master.cf — rendered by mail-deploy (cleaned from the reference box).
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ==========================================================================

# Port 25 is fronted by postscreen (zombie/DNSBL filtering before smtpd).
smtp      inet  n       -       n       -       1       postscreen
smtpd     pass  -       -       n       -       200     smtpd
dnsblog   unix  -       -       n       -       0       dnsblog
tlsproxy  unix  -       -       n       -       0       tlsproxy

# Submission (587, STARTTLS) and SMTPS (465, wrapper) — auth required + rate limited.
submission inet n       -       n       -       -       smtpd
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_etrn_restrictions=reject
  -o smtpd_client_auth_rate_limit=30
  -o smtpd_client_recipient_rate_limit=200
smtps     inet  n       -       n       -       200     smtpd
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  # NOTE: this stanza deliberately has NO smtpd_sender_restrictions override.
  # It used to carry "permit_sasl_authenticated,reject_sender_login_mismatch",
  # which is INERT -- permit_sasl_authenticated matches first for every
  # authenticated client and terminates the list, so the mismatch check never
  # ran. It read like anti-spoofing while providing none. The guard now lives
  # once in main.cf (see smtpd_sender_restrictions there) and this port
  # inherits it.
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_etrn_restrictions=reject
  -o smtpd_client_auth_rate_limit=30
  -o smtpd_client_recipient_rate_limit=200

pickup    fifo  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      fifo  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
  -o fallback_relay=
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# SPF policy daemon — called from smtpd_recipient_restrictions. Package/user/
# binary path differ by OS (EL: pypolicyd-spf, dedicated user, /usr/libexec;
# Debian: postfix-policyd-spf-python, runs as nobody, /usr/bin) -- resolved
# by 20-postfix.sh via POLICYD_SPF_USER/POLICYD_SPF_BIN.
policyd-spf unix -      n       n       -       0       spawn
  user=@@POLICYD_SPF_USER@@ argv=@@POLICYD_SPF_BIN@@
