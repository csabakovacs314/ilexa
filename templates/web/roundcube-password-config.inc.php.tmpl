<?php
// Roundcube password plugin — rendered by mail-deploy. chown apache:apache
// after write. Writes crypt hashes back to the PostfixAdmin mailbox table.
$config['password_driver'] = 'sql';
$config['password_db_dsn'] = 'mysql://@@DB_USER@@:@@DB_PASSWORD@@@127.0.0.1/postfix';
// bare %P / %u / %d (no quotes) — the plugin binds them itself via $db->quote()
// (drivers/sql.php); quoting them here breaks the update.
//
// password_expiry is reset here too, not just password/modified: without
// this, PostfixAdmin's own change-password path resets the expiry clock but
// Roundcube's does not, so a user who dutifully changes their expired
// password via webmail would be silently re-expired on the spot. %d is the
// plugin's own domain-part token (split from %u by the driver already, no
// SUBSTRING_INDEX needed) -- joined to domain.password_expiry, the same
// per-domain days value MailboxHandler.php:280-292 computes in PHP,
// expressed here in SQL. A domain with password_expiration disabled has
// password_expiry=0, giving NOW()+0=NOW() -- harmless (nothing enforces it)
// and matches PostfixAdmin's own unconditional-computation precedent rather
// than adding a second code path for that case.
$config['password_query'] = "UPDATE mailbox m JOIN domain d ON d.domain = %d
  SET m.password = %P, m.modified = NOW(),
      m.password_expiry = NOW() + INTERVAL d.password_expiry DAY
  WHERE m.username = %u";
$config['password_algorithm'] = 'sha512-crypt';
$config['password_algorithm_prefix'] = '';
$config['password_minimum_length'] = 8;
$config['password_require_nonalpha'] = false;
$config['password_log'] = true;
