<?php
// Roundcube password plugin — rendered by mail-deploy. chown apache:apache
// after write. Writes crypt hashes back to the PostfixAdmin mailbox table.
$config['password_driver'] = 'sql';
$config['password_db_dsn'] = 'mysql://@@DB_USER@@:@@DB_PASSWORD@@@127.0.0.1/postfix';
// bare %P / %u (no quotes) — the plugin binds them; quoting breaks the update.
$config['password_query'] = "UPDATE mailbox SET password=%P, modified=NOW() WHERE username=%u";
$config['password_algorithm'] = 'sha512-crypt';
$config['password_algorithm_prefix'] = '';
$config['password_minimum_length'] = 8;
$config['password_require_nonalpha'] = false;
$config['password_log'] = true;
