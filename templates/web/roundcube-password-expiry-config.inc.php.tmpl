<?php
// Roundcube password_expiry plugin — rendered by mail-deploy. chown apache:apache
// after write.
//
// Same DB user the sibling secondary_email plugin already uses for the same
// mailbox table (postfix's own app-level DB user, also used by PostfixAdmin
// and Dovecot) -- not a newly-scoped read-only grant. This plugin only reads
// one column, but that user already has full read/write access to this
// exact table via secondary_email's own UPDATE, so a narrower grant here
// would add a second DB-access pattern for the same table without reducing
// any actual exposure.
$config['password_expiry_db_dsn'] = 'mysql://@@DB_USER@@:@@DB_PASSWORD@@@127.0.0.1/postfix';
// Days before password_expiry the warning banner appears.
$config['password_expiry_warn_days'] = 7;
