<?php
// landing.php — domain-root gateway page, rendered by mail-deploy.
// Anonymous, unauthenticated, public: no mail content or admin state is
// reachable from here, only links out to Roundcube and the ilexa console.
//
// Default language mirrors the choice made during installation (ilexa's own
// site-wide language file — see postfixadmin-config.local.php.tmpl for the
// same convention), then a per-visitor cookie can override it without ever
// touching that shared file: this page has many anonymous visitors, not one
// operator, so the choice must stay local to the browser, not global state.

$SUPPORTED = ['en', 'hu'];
$LANG_FILE = '@@ILEXA_LANG_FILE@@';
$LANG_DEFAULT = '@@ILEXA_LANG_DEFAULT@@';

// Visitor toggled the switcher: validate against a strict whitelist (never
// reflect raw input), persist as a cookie, then redirect to a clean URL —
// the target is always the fixed literal '/', never derived from request
// data, so this cannot become an open redirect.
if (isset($_GET['lang']) && in_array($_GET['lang'], $SUPPORTED, true)) {
    setcookie('landing_lang', $_GET['lang'], [
        'expires' => time() + 31536000,
        'path' => '/',
        'secure' => true,
        'httponly' => true,
        'samesite' => 'Lax',
    ]);
    header('Location: /');
    exit;
}

$lang = $LANG_DEFAULT;
if (isset($_COOKIE['landing_lang']) && in_array($_COOKIE['landing_lang'], $SUPPORTED, true)) {
    $lang = $_COOKIE['landing_lang'];
} elseif (is_readable($LANG_FILE)) {
    $fileLang = strtolower(trim((string) @file_get_contents($LANG_FILE)));
    if (in_array($fileLang, $SUPPORTED, true)) {
        $lang = $fileLang;
    }
}

$STRINGS = [
    'en' => [
        'title' => 'Webmail',
        'heading' => 'Webmail Access',
        'rc_desc' => 'Modern, fast webmail client in your browser. Folder management, filters, HTML composer.',
        'rc_cta' => 'Sign in',
        'ilexa_title' => 'ilexa Console',
        'ilexa_desc' => 'Mail security operations console: quarantine, spam/virus filtering, IOC lookup, system status.',
        'ilexa_cta' => 'Open',
    ],
    'hu' => [
        'title' => 'Levelezés',
        'heading' => 'Webmail elérés',
        'rc_desc' => 'Modern, gyors levelezőkliens böngészőben. Mappa-kezelés, szűrők, HTML szerkesztő.',
        'rc_cta' => 'Belépés',
        'ilexa_title' => 'ilexa konzol',
        'ilexa_desc' => 'Levélbiztonsági műveleti konzol: karantén, spam-/vírusszűrés, IOC-keresés, rendszerállapot.',
        'ilexa_cta' => 'Megnyitás',
    ],
][$lang];

$fqdn = '@@MAIL_FQDN@@';
$showIlexa = @@SHOW_ILEXA@@;
$ilexaPrefix = '@@ILEXA_URL_PREFIX@@';
