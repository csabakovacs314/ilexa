    /* ONE brand treatment shared by both cards, so they read as a set.
       Both products' logos are drawn for light backgrounds (ilexa's shield
       is white/light-grey, Roundcube's mark uses mid-greys), so neither can
       sit directly on the dark card -- ilexa's lockup in particular has an
       opaque white background baked into the PNG and rendered as a white
       slab. A shared light plate is what makes them consistent AND keeps
       both brands' real colours correct.
       Fixed height + object-fit:contain is what actually does the
       harmonising: the two logos have quite different aspect ratios, and
       this makes them occupy an identical box regardless. */
    .card-brand {
      height: 148px;
      border-radius: 14px;
      background: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
