<?php
// Roundcube main config — rendered by mail-deploy. Ownership root:apache 640.
$config['db_dsnw'] = 'mysql://@@RC_DB_USER@@:@@RC_DB_PASSWORD@@@127.0.0.1/roundcube';
$config['imap_host'] = 'ssl://localhost:993';
$config['smtp_host'] = 'ssl://localhost:465';
// The cert on :993/:465 is issued for the public FQDN, never for the literal
// "localhost" this loopback connection dials -- PHP's default stream
// verification rejects that CN mismatch and every login fails with an
// opaque "Could not connect ... Unknown reason". Confirmed live: hawking's
// hand-edited production config already carries this exact fix; a fresh
// install from this template did not, and its Roundcube could not
// authenticate anyone.
$config['imap_conn_options'] = ['ssl' => ['verify_peer' => false, 'verify_peer_name' => false]];
$config['smtp_conn_options'] = ['ssl' => ['verify_peer' => false, 'verify_peer_name' => false]];
$config['smtp_user'] = '%u';
$config['smtp_pass'] = '%p';
$config['support_url'] = '';
$config['product_name'] = 'Webmail';
$config['des_key'] = '@@DES_KEY@@';
$config['plugins'] = array(@@RC_PLUGINS@@);
$config['default_host'] = 'ssl://localhost';
$config['smtp_server'] = 'ssl://localhost';
$config['enable_installer'] = false;

// ---- language: follow the ilexa console ------------------------------------
// Same source of truth PostfixAdmin uses (see
// templates/web/postfixadmin-config.local.php.tmpl): ilexa stores the
// site-wide language as a bare 'hu'/'en' in this file and its Admin tab
// rewrites it, so all three web apps move together instead of each freezing
// whatever was chosen at install time.
//
// Roundcube wants an RFC1766 locale ('en_US'), not a bare code, and the value
// reaches setlocale() and a localization PATH -- so it is resolved through a
// fixed whitelist map, never used as read.
//
// This is a DEFAULT, not a lock: rcmail::set_user() loads the user's own
// preferences into config before reading 'language', so anyone who picks a
// language in Roundcube's own settings keeps it.
$_sys_lang_file = '@@ILEXA_LANG_FILE@@';
$_sys_lang      = '@@SYSTEM_LANG@@';
if (is_readable($_sys_lang_file)) {
    $_l = strtolower(trim((string) @file_get_contents($_sys_lang_file)));
    if ($_l === 'en' || $_l === 'hu') {
        $_sys_lang = $_l;
    }
}
$_rc_locales = ['en' => 'en_US', 'hu' => 'hu_HU'];
$config['language'] = $_rc_locales[$_sys_lang] ?? 'en_US';
unset($_sys_lang_file, $_sys_lang, $_l, $_rc_locales);
